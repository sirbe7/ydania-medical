{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ydania-medical",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ydania-scheduling",
      "database_id": "d3d1fd52-c99e-4517-af5f-7ed2042e06b9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_PROVIDER": "openai",
    "WHATSAPP_PROVIDER": "ycloud"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "ADMIN_SECRET",
      "LOG_HASH_SALT",
      "RESEND_API_KEY",
      "RESEND_WEBHOOK_SECRET"
    ]
  }
}
